{
  "id":"/",
  "name":"Smart Link Hub V6",
  "short_name":"Link Hub",
  "description":"Local-first AI web library with Auto Save, conflict-safe cloud sync, Trash, Read Later and versioned backup.",
  "start_url":"/",
  "scope":"/",
  "display":"standalone",
  "display_override":["window-controls-overlay","standalone","minimal-ui"],
  "orientation":"any",
  "background_color":"#060b13",
  "theme_color":"#060b13",
  "categories":["productivity","utilities","education"],
  "lang":"th",
  "dir":"ltr",
  "icons":[
    {"src":"icons/icon.svg","sizes":"any","type":"image/svg+xml","purpose":"any maskable"}
  ],
  "shortcuts":[
    {"name":"Add Link","short_name":"Add","description":"Capture a new web link","url":"/?v6=add","icons":[{"src":"icons/icon.svg","sizes":"any","type":"image/svg+xml"}]},
    {"name":"Read Later","short_name":"Read Later","description":"Open your reading queue","url":"/?v6=read-later","icons":[{"src":"icons/icon.svg","sizes":"any","type":"image/svg+xml"}]},
    {"name":"Ask My Links","short_name":"AI Search","description":"Search and ask questions across saved links","url":"/?v6=ai","icons":[{"src":"icons/icon.svg","sizes":"any","type":"image/svg+xml"}]},
    {"name":"Cloud & Backup","short_name":"Backup","description":"Review sync and version history","url":"/?v6=cloud","icons":[{"src":"icons/icon.svg","sizes":"any","type":"image/svg+xml"}]}
  ],
  "share_target":{
    "action":"/?share=1",
    "method":"GET",
    "enctype":"application/x-www-form-urlencoded",
    "params":{"title":"title","text":"text","url":"url"}
  },
  "launch_handler":{"client_mode":["navigate-existing","auto"]},
  "handle_links":"preferred"
}