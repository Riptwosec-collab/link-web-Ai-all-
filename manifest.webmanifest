  "scope":"/",
  "display":"standalone",
  "display_override":["window-controls-overlay","standalone","minimal-ui"],
  "orientation":"any",
  "background_color":"#020304",
  "theme_color":"#020304",
  "categories":["productivity","utilities","education"],
  "lang":"th",
  "dir":"ltr",
  "icons":[{"src":"icons/icon.svg","sizes":"any","type":"image/svg+xml","purpose":"any maskable"}],
  "shortcuts":[
    {"name":"Add Link","short_name":"Add","description":"Save a new web link directly to Supabase","url":"/?v6=add","icons":[{"src":"icons/icon.svg","sizes":"any","type":"image/svg+xml"}]},
    {"name":"Semantic AI","short_name":"AI Search","description":"Search your saved library by meaning","url":"/?v7=semantic","icons":[{"src":"icons/icon.svg","sizes":"any","type":"image/svg+xml"}]},
    {"name":"Read Later","short_name":"Read Later","description":"Open your reading queue","url":"/?v6=read-later","icons":[{"src":"icons/icon.svg","sizes":"any","type":"image/svg+xml"}]},
    {"name":"System Status","short_name":"Status","description":"Verify Cloud, Worker, PWA and build health","url":"/?v7=status","icons":[{"src":"icons/icon.svg","sizes":"any","type":"image/svg+xml"}]},
    {"name":"Cloud & Data","short_name":"Backups","description":"Open Supabase history, backups and recovery","url":"/#settings","icons":[{"src":"icons/icon.svg","sizes":"any","type":"image/svg+xml"}]}
  ],
  "share_target":{"action":"/?share=1","method":"GET","enctype":"application/x-www-form-urlencoded","params":{"title":"title","text":"text","url":"url"}},
